# ──────────────────────────────────────────────────────────
# SimTraction Pro – Environment Variables Example
# Copy this file to .env and fill in the values.
# ──────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────
DB_PASSWORD=simtraction_secret
DATABASE_URL=sqlite:///./simtraction.db

# ── Redis ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Security ──────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_in_production

# ── CORS ──────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Base V1 (projets CSV lus par l'API) ─────────────────
# Par défaut : SimTraction_V1/BDD à la racine du dépôt
# V1_BDD_DIR=C:/chemin/vers/BDD

# ── Environment ───────────────────────────────────────
ENVIRONMENT=development

# ── Frontend ──────────────────────────────────────────
VITE_API_URL=http://localhost:8000
